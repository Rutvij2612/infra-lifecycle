# Server
PORT=4000
NODE_ENV=development

# Comma-separated list of allowed frontend origins (CORS)
CORS_ORIGIN=http://localhost:5173

# Supabase PostgreSQL connection string.
# Supabase dashboard -> Project Settings -> Database -> Connection string.
# Use the "Connection pooling" (port 6543) string when deploying to Render.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_HOST:5432/postgres

# Supabase requires SSL. Set to "false" only for a plain local PostgreSQL.
DATABASE_SSL=true

# --- Authentication -------------------------------------------------------
# Secret used to sign login tokens (JWT, HS256). REQUIRED. Use a long random value,
# at least 32 characters, different per environment. The API refuses to start in
# production without it. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Token lifetime (jsonwebtoken format: 15m, 8h, 7d ...). Default 8h.
JWT_EXPIRES_IN=8h
